digraph G {
  rankdir=LR; fontname="Helvetica"; nodesep=0.45; ranksep=0.9; bgcolor="white";
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#667085", arrowsize=0.7];

  dim_date [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef4ff"><TR><TD BGCOLOR="#2f6fed"><FONT COLOR="white"><B>dim_date</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="k">PK date_key (AAAAMMDD)</TD></TR><TR><TD ALIGN="LEFT">full_date, year, quarter, month</TD></TR><TR><TD ALIGN="LEFT">year_month, day_of_week, is_weekend</TD></TR></TABLE>>];
  dim_country [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef4ff"><TR><TD BGCOLOR="#2f6fed"><FONT COLOR="white"><B>dim_country</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="k">PK country_key</TD></TR><TR><TD ALIGN="LEFT">country_name (unique)</TD></TR></TABLE>>];
  dim_customer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef4ff"><TR><TD BGCOLOR="#2f6fed"><FONT COLOR="white"><B>dim_customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="k">PK customer_key (0 = ANONYMOUS)</TD></TR><TR><TD ALIGN="LEFT">customer_id (unique), is_identified</TD></TR></TABLE>>];
  dim_product [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eef4ff"><TR><TD BGCOLOR="#2f6fed"><FONT COLOR="white"><B>dim_product</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="k">PK product_key</TD></TR><TR><TD ALIGN="LEFT">stock_code (unique, normalizado)</TD></TR><TR><TD ALIGN="LEFT">canonical_description</TD></TR><TR><TD ALIGN="LEFT">category, category_source</TD></TR><TR><TD ALIGN="LEFT">supplier_country, is_active</TD></TR><TR><TD ALIGN="LEFT">raw_/normalized_variant_count</TD></TR></TABLE>>];
  variant [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f5"><TR><TD BGCOLOR="#667085"><FONT COLOR="white"><B>product_description_variant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="k">PK/FK product_key</TD></TR><TR><TD ALIGN="LEFT">PK raw_description, occurrences</TD></TR></TABLE>>];
  fact_sales [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#effaf1"><TR><TD BGCOLOR="#1a7f37"><FONT COLOR="white"><B>fact_sales</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK line_id (uuid determinista)</TD></TR><TR><TD ALIGN="LEFT">invoice_no, invoice_ts_utc</TD></TR><TR><TD ALIGN="LEFT" PORT="d">FK date_key</TD></TR><TR><TD ALIGN="LEFT" PORT="p">FK product_key</TD></TR><TR><TD ALIGN="LEFT" PORT="c">FK customer_key</TD></TR><TR><TD ALIGN="LEFT" PORT="k">FK country_key</TD></TR><TR><TD ALIGN="LEFT">quantity &gt; 0, unit_price &gt; 0</TD></TR><TR><TD ALIGN="LEFT">gross_revenue, source_system</TD></TR></TABLE>>];
  fact_returns [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff4ec"><TR><TD BGCOLOR="#c4561a"><FONT COLOR="white"><B>fact_returns</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK line_id (uuid determinista)</TD></TR><TR><TD ALIGN="LEFT">invoice_no, invoice_ts_utc</TD></TR><TR><TD ALIGN="LEFT" PORT="d">FK date_key</TD></TR><TR><TD ALIGN="LEFT" PORT="p">FK product_key</TD></TR><TR><TD ALIGN="LEFT" PORT="c">FK customer_key</TD></TR><TR><TD ALIGN="LEFT" PORT="k">FK country_key</TD></TR><TR><TD ALIGN="LEFT">quantity_returned, unit_price</TD></TR><TR><TD ALIGN="LEFT">return_amount, is_cancellation_invoice</TD></TR></TABLE>>];
  agg [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f6f0ff"><TR><TD BGCOLOR="#6f42c1"><FONT COLOR="white"><B>agg_daily_product_net</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK/FK date_key + product_key</TD></TR><TR><TD ALIGN="LEFT">units_sold, units_returned</TD></TR><TR><TD ALIGN="LEFT">gross_revenue, returns_amount</TD></TR><TR><TD ALIGN="LEFT"><B>net_revenue</B> = bruto - devoluciones</TD></TR></TABLE>>];
  rej [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f5"><TR><TD BGCOLOR="#667085"><FONT COLOR="white"><B>rejected_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK rejection_id, run_date</TD></TR><TR><TD ALIGN="LEFT">source_system, source_row</TD></TR><TR><TD ALIGN="LEFT">reject_reason, payload (jsonb)</TD></TR></TABLE>>];
  run [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f5"><TR><TD BGCOLOR="#667085"><FONT COLOR="white"><B>etl_run_summary</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK run_date, metrics (jsonb)</TD></TR></TABLE>>];

  fact_sales:d -> dim_date:k; fact_sales:p -> dim_product:k; fact_sales:c -> dim_customer:k; fact_sales:k -> dim_country:k;
  fact_returns:d -> dim_date:k; fact_returns:p -> dim_product:k; fact_returns:c -> dim_customer:k; fact_returns:k -> dim_country:k;
  agg -> dim_date:k; agg -> dim_product:k;
  variant -> dim_product:k;
}
