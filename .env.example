# ============================================================
# DataMart ETL - variables de entorno
# Copia este archivo a ".env" (cp .env.example .env) y ajusta valores.
# El archivo ".env" real NO se versiona (ver .gitignore).
# ============================================================

# --- Metadatos internos de Airflow (base de datos 1) ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambia_esta_clave_airflow

# --- Repositorio analitico destino (base de datos 2, separada) ---
DW_DB_NAME=datamart_dw
DW_DB_USER=datamart
DW_DB_PASSWORD=cambia_esta_clave_dw
# Puerto expuesto en tu maquina para conectarte con DBeaver/psql
DW_HOST_PORT=5433

# --- Airflow ---
# Genera tu propia clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=As1CDB1wYtwfD6KtCYVPyrALuRzYuYx0UvokXnzExSQ=
AIRFLOW_SECRET_KEY=cambia_este_secreto_del_webserver
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia_esta_clave_admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEB_PORT=8080
# Solo Linux: lo completa iniciar.sh con tu usuario (en Mac y Windows se deja en 50000)
AIRFLOW_UID=50000

# --- API interna de productos (servicio opcional) ---
PRODUCTS_API_PORT=8000
PRODUCTS_API_TOKEN=cambia_este_token_de_la_api

# --- Variables operativas del pipeline (se cargan como Airflow Variables) ---
DATAMART_SOURCE_TIMEZONE=Europe/London
DATAMART_MAX_REJECTION_RATIO=0.30
DATAMART_USE_PRODUCTS_API=true
DATAMART_API_PAGE_SIZE=500
DATAMART_SALES_DAILY_FILE=data.csv
DATAMART_SALES_HISTORY_FILE=online_retail.csv

# --- Descarga automatica desde Kaggle (con kagglehub) ---
# Si los CSV no estan en data/raw/, el pipeline los descarga solo (los datasets son publicos).
# Las credenciales son OPCIONALES: solo si tu red o Kaggle piden iniciar sesion.
# Si tampoco hay descarga posible, usa los datos de prueba de seeds/.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_SALES_DAILY=carrie1/ecommerce-data
KAGGLE_DATASET_SALES_HISTORY=thedevastator/online-retail-transaction-data
